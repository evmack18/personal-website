---
import BaseLayout from "../layouts/BaseLayout.astro";
import FloatingNav from "../components/FloatingNav.astro";
import PageContainer from "../components/PageContainer.astro";
import Hero from "../components/Hero.astro";
import ImageMarquee from "../components/ImageMarquee.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Experience from "../components/Experience.astro";
import Contact from "../components/Contact.astro";
import { site } from "../content/site";
---

<BaseLayout
  title={site.name}
  description={`${site.hero.lead} ${site.hero.typingPhrases[0]}`}
>
  <main id="main">
    <div class="px-5 sm:px-20">
      <div class="site-column relative mx-auto w-full max-w-[1280px]">
        <div class="site-grid-line site-grid-line--left" aria-hidden="true"></div>
        <div class="site-grid-line site-grid-line--right" aria-hidden="true"></div>

        <FloatingNav />
        <PageContainer class="pt-[88px] pb-[75px] sm:pt-[142px] sm:pb-[220px]">
          <Hero />
        </PageContainer>
      </div>
    </div>

    <div class="marquee-zone">
      <div class="marquee-zone__line" aria-hidden="true"></div>
      <ImageMarquee />
      <div class="marquee-zone__line" aria-hidden="true"></div>
    </div>

    <div class="px-5 sm:px-20">
      <div class="site-column relative mx-auto w-full max-w-[1280px] pt-[180px] sm:pt-[220px]">
        <div class="site-grid-line site-grid-line--left" aria-hidden="true"></div>
        <div class="site-grid-line site-grid-line--right" aria-hidden="true"></div>

        <PageContainer>
          <CaseStudies />
        </PageContainer>
        <Experience />
        <Contact />
      </div>
    </div>
  </main>
</BaseLayout>
