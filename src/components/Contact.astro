---
import { site } from "../content/site";

const links = [
  { label: "Email", href: `mailto:${site.email}` },
  { label: "GitHub", href: site.links.github },
  ...(site.links.linkedin
    ? [{ label: "LinkedIn", href: site.links.linkedin }]
    : []),
];
---

<section
  id="contact"
  class="mx-auto max-w-6xl border-t border-border px-6 py-16"
  aria-labelledby="contact-heading"
>
  <h2
    id="contact-heading"
    class="text-sm font-semibold uppercase tracking-wider text-muted"
  >
    Contact
  </h2>
  <p class="mt-4 max-w-xl text-muted">
    Open to interesting work and conversations. Reach out via email or GitHub.
  </p>
  <ul class="mt-6 flex flex-wrap gap-4">
    {
      links.map((link) => (
        <li>
          <a
            href={link.href}
            class="inline-flex items-center rounded-lg border border-border px-4 py-2 text-sm font-medium text-foreground hover:border-muted"
            {...(link.href.startsWith("http")
              ? { target: "_blank", rel: "noopener noreferrer" }
              : {})}
          >
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>

<footer class="mx-auto max-w-6xl px-6 py-10 text-center text-sm text-muted">
  <p>
    &copy; {new Date().getFullYear()}
    {site.name}
  </p>
</footer>
