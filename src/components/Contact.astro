---
import { site } from "../content/site";

const year = new Date().getFullYear();

const contactLinks = [
  ...(site.links.linkedin
    ? [{ label: "LinkedIn", href: site.links.linkedin, external: true }]
    : []),
  {
    label: "Resume",
    href: site.contact.resumeUrl,
    external: true,
    download: "Evan_McCormack_Resume_2026.pdf",
  },
];
---

<section
  id="contact"
  class="bg-background pb-16 pt-16 sm:pb-24 sm:pt-24"
  aria-labelledby="contact-heading"
>
  <div class="px-5 sm:px-20">
    <div class="mx-auto w-full max-w-[1280px]">
      <p
        id="contact-heading"
        class="max-w-[922px] text-[28px] font-normal leading-[36px] text-heading sm:text-[40px] sm:leading-[52px]"
      >
        {site.contact.intro}
      </p>

      <ul class="mt-12 space-y-3 sm:mt-16">
        <li>
          <a
            href={`mailto:${site.email}`}
            class="text-[14px] leading-[21px] text-muted transition-colors hover:text-heading"
          >
            Email: {site.email}
          </a>
        </li>
        {
          contactLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-[14px] leading-[21px] text-muted transition-colors hover:text-heading"
                {...(link.external
                  ? { target: "_blank", rel: "noopener noreferrer" }
                  : {})}
                {...("download" in link && link.download
                  ? { download: link.download }
                  : {})}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <footer class="mt-24 border-t border-accent-bar pt-6 sm:mt-[120px]">
        <div
          class="flex flex-col gap-3 text-[14px] leading-[21px] text-muted sm:flex-row sm:items-center sm:justify-between"
        >
          <p>
            &copy; {year} – {site.name}
          </p>
          <p class="uppercase tabular-nums">
            <span>{site.contact.location}</span>
            <span aria-hidden="true"> | </span>
            <time
              class="contact-local-time"
              datetime=""
              data-timezone={site.contact.timeZone}
            ></time>
          </p>
        </div>
      </footer>
    </div>
  </div>
</section>

<script>
  function formatContactLocalTime(timeZone) {
    const parts = new Intl.DateTimeFormat("en-US", {
      timeZone,
      hour: "numeric",
      minute: "2-digit",
      hour12: true,
    }).formatToParts(new Date());

    const hour = parts.find((part) => part.type === "hour")?.value ?? "";
    const minute = parts.find((part) => part.type === "minute")?.value ?? "";
    const dayPeriod =
      parts.find((part) => part.type === "dayPeriod")?.value ?? "";

    return `${hour}:${minute} ${dayPeriod} PST`;
  }

  function initContactLocalTime() {
    document.querySelectorAll(".contact-local-time").forEach((element) => {
      if (!(element instanceof HTMLTimeElement)) return;

      const timeZone = element.dataset.timezone || "America/Los_Angeles";

      const updateTime = () => {
        const now = new Date();
        element.dateTime = now.toISOString();
        element.textContent = formatContactLocalTime(timeZone);
      };

      updateTime();
      window.setInterval(updateTime, 30_000);
    });
  }

  initContactLocalTime();
  document.addEventListener("astro:page-load", initContactLocalTime);
</script>
