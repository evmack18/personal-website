---
import { getCaseStudies } from "../content/projects";
import CaseStudy from "./CaseStudy.astro";

const caseStudies = getCaseStudies();
---

<section
  id="projects"
  class="space-y-[144px] pb-24"
  aria-label="Case studies"
>
  {caseStudies.map((study) => <CaseStudy study={study} />)}
</section>
