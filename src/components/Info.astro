---
import { contactFields, experience } from "../content/info";
---

<section
  id="info"
  class="mt-[144px] px-5 pb-24 sm:px-20"
  aria-labelledby="info-label"
>
  <div
    class="grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-x-8 xl:grid-cols-4"
  >
    <span
      id="info-label"
      class="inline-block w-fit rounded-full bg-[#262626] px-5 py-2 text-sm font-normal text-foreground"
    >
      Info
    </span>
    <span
      class="inline-block w-fit rounded-full bg-[#262626] px-5 py-2 text-sm font-normal text-foreground sm:col-start-2 xl:col-start-4"
    >
      Contact
    </span>
  </div>

  <div
    class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-12 xl:grid-cols-4"
  >
    <div class="space-y-12 xl:col-span-3">
      {
        experience.map((entry) => (
          <article>
            <h2 class="text-[16px] font-bold leading-6 text-title">
              {entry.company}
              <span class="font-bold">{"  "}{entry.dates}{"  "}</span>
              <span class="font-light">|</span>
              <span class="font-bold">{"   "}{entry.role}</span>
            </h2>
            <p class="mt-3 text-[14px] leading-[21px] text-muted">
              {entry.description}
            </p>
          </article>
        ))
      }
    </div>

    <aside class="space-y-12 sm:col-start-2 xl:col-start-4">
      {
        contactFields.map((field) => (
          <div>
            <h3 class="text-[16px] font-bold leading-6 text-title">
              {field.label}
            </h3>
            {field.href ? (
              <a
                href={field.href}
                class="mt-3 block text-[14px] leading-[21px] text-muted transition-colors hover:text-foreground"
              >
                {field.value}
              </a>
            ) : (
              <p class="mt-3 text-[14px] leading-[21px] text-muted">
                {field.value}
              </p>
            )}
          </div>
        ))
      }
    </aside>
  </div>
</section>
