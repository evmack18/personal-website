<button
  type="button"
  id="theme-toggle"
  class="theme-toggle flex size-9 shrink-0 items-center justify-center rounded-[6px] text-foreground transition-colors hover:bg-nav-hover"
  aria-label="Switch to light mode"
  title="Switch to light mode"
>
  <svg
    class="theme-toggle__icon theme-toggle__icon--dark size-5"
    viewBox="0 0 20 20"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M12.8 3.4a6.4 6.4 0 1 0 5.4 10.1A5.4 5.4 0 0 1 12.8 3.4Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"></path>
    <path
      d="M16.8 2.2v2.2M17.9 3.3h-2.2M16.8 5.5l.8-.8M16.8 1.1l.8.8"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>

  <svg
    class="theme-toggle__icon theme-toggle__icon--light size-5"
    viewBox="0 0 20 20"
    fill="none"
    aria-hidden="true"
  >
    <circle
      cx="10"
      cy="10"
      r="3.5"
      stroke="currentColor"
      stroke-width="1.5"></circle>
    <path
      d="M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.4 4.4l1.4 1.4M14.2 14.2l1.4 1.4M4.4 15.6l1.4-1.4M14.2 5.8l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
</button>

<script>
  function getTheme() {
    return document.documentElement.getAttribute("data-theme") === "light"
      ? "light"
      : "dark";
  }

  function updateThemeToggle(theme) {
    const button = document.getElementById("theme-toggle");
    if (!button) return;

    const nextTheme = theme === "dark" ? "light" : "dark";
    button.setAttribute(
      "aria-label",
      `Switch to ${nextTheme} mode`,
    );
    button.setAttribute("title", `Switch to ${nextTheme} mode`);
  }

  function setTheme(theme) {
    document.documentElement.setAttribute("data-theme", theme);
    localStorage.setItem("theme", theme);
    updateThemeToggle(theme);
  }

  function initThemeToggle() {
    const button = document.getElementById("theme-toggle");
    if (!button || button.dataset.initialized === "true") return;

    button.dataset.initialized = "true";
    updateThemeToggle(getTheme());

    button.addEventListener("click", () => {
      setTheme(getTheme() === "dark" ? "light" : "dark");
    });
  }

  initThemeToggle();
  document.addEventListener("astro:page-load", initThemeToggle);
</script>
