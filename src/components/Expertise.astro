---
import { expertiseAreas } from "../content/expertise";
---

<section
  id="expertise"
  class="mt-[144px] px-5 pb-24 sm:px-20"
  aria-labelledby="expertise-label"
>
  <span
    id="expertise-label"
    class="inline-block rounded-full bg-[#262626] px-5 py-2 text-sm font-normal text-foreground"
  >
    Expertise
  </span>

  <div
    class="mt-12 grid grid-cols-1 gap-10 sm:grid-cols-2 sm:gap-x-8 sm:gap-y-12 xl:grid-cols-4"
  >
    {
      expertiseAreas.map((area) => (
        <article>
          <div class="flex items-start gap-2">
            <svg
              class="mt-1 size-3 shrink-0"
              viewBox="0 0 12 12"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M6 0L7.2 4.8L12 6L7.2 7.2L6 12L4.8 7.2L0 6L4.8 4.8L6 0Z"
                fill="#B90882"></path>
            </svg>
            <h2 class="text-base font-medium leading-6 text-foreground">
              {area.title}
            </h2>
          </div>
          <p class="mt-3 text-sm leading-[21px] text-muted">{area.description}</p>
        </article>
      ))
    }
  </div>
</section>
