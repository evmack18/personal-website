---
import type { CaseStudy } from "../content/projects";

interface Props {
  study: CaseStudy;
}

const { study } = Astro.props;
---

<article class="case-study px-5 sm:px-20">
  <div
    class="flex flex-col gap-8 lg:flex-row lg:items-start lg:justify-between"
  >
    <div
      class="order-2 w-full max-w-[315px] shrink-0 lg:order-1 lg:pt-[75px]"
    >
      <h2 class="text-[16px] font-bold leading-6 text-title">
        {study.title}
      </h2>
      <div class="mt-3 space-y-0 text-[14px] leading-[21px] text-muted">
        {study.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>

    <div
      class="order-1 w-full shrink-0 lg:order-2 lg:w-[min(1050px,calc(100%-380px))]"
    >
      <div
        class="aspect-[7/4] w-full bg-placeholder-light"
        role="img"
        aria-label={`${study.title} preview placeholder`}
      >
      </div>
      <div class="mt-4 flex w-full items-center justify-between">
        <div class="flex items-center gap-[15px]">
          <button
            type="button"
            class="flex size-5 items-center justify-center text-muted"
            aria-label="Previous slide"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M16 10H4M4 10L9 5M4 10L9 15"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
          <button
            type="button"
            class="flex size-5 items-center justify-center text-muted"
            aria-label="Next slide"
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10H16M16 10L11 5M16 10L11 15"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </button>
        </div>
        <p class="text-[14px] text-muted">{study.slideLabel}</p>
      </div>
    </div>
  </div>
</article>
