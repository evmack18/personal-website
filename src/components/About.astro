---
import { about } from "../content/about";
---

<section
  id="about"
  class="mx-auto max-w-6xl border-t border-border px-6 py-16"
  aria-labelledby="about-heading"
>
  <h2
    id="about-heading"
    class="text-sm font-semibold uppercase tracking-wider text-muted"
  >
    About
  </h2>
  <div class="mt-6 max-w-2xl space-y-4 text-muted">
    {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
  </div>
</section>
