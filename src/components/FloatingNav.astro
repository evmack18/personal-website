---
import { site } from "../content/site";
import ThemeToggle from "./ThemeToggle.astro";

const isLeadershipPage = Astro.url.pathname.startsWith("/leadership");

function isNavItemActive(href: string) {
  return href === "/leadership" && isLeadershipPage;
}
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-5 focus:top-5 focus:z-[60] focus:rounded-md focus:bg-foreground focus:px-3 focus:py-2 focus:text-background"
>
  Skip to content
</a>

<header class="relative z-[3]">
  <div class="grid-content-inset pb-5 pt-7">
    <nav class="flex items-center justify-between" aria-label="Primary">
      <a
        href="/"
        class="text-[16px] font-semibold leading-none text-foreground transition-opacity hover:opacity-80"
      >
        {site.name}
      </a>

      <div class="flex items-center gap-1 sm:gap-2">
        <ul class="flex items-center gap-1 sm:gap-2">
          {
            site.mainNav.map((item) => {
              const isActive = isNavItemActive(item.href);

              return (
                <li>
                  <a
                    href={item.href}
                    class:list={[
                      "px-3 py-2 text-[16px] leading-none text-foreground transition-opacity hover:opacity-80",
                      isActive ? "font-semibold" : "font-light",
                    ]}
                    {...(isActive ? { "aria-current": "page" } : {})}
                  >
                    {item.label}
                  </a>
                </li>
              );
            })
          }
        </ul>

        <ThemeToggle />
      </div>
    </nav>
  </div>
  <div class="site-full-bleed-line" aria-hidden="true"></div>
</header>
