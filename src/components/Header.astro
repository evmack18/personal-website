---
import { site } from "../content/site";
import TypingNav from "./TypingNav.astro";
---

<a
  href="#main"
  class="sr-only focus:not-sr-only focus:absolute focus:left-5 focus:top-5 focus:z-50 focus:rounded-md focus:bg-foreground focus:px-3 focus:py-2 focus:text-background"
>
  Skip to content
</a>

<header class="px-5 pt-[35px] sm:px-20">
  <div
    class="grid grid-cols-1 items-center gap-3 text-[18px] leading-none sm:grid-cols-[1fr_auto_1fr]"
  >
    <p class="text-[20px] font-semibold text-foreground sm:justify-self-start">
      {site.name}
    </p>
    <p class="font-light text-foreground sm:justify-self-center sm:px-6 sm:text-center">
      {site.nav.center}
    </p>
    <TypingNav />
  </div>
</header>
